{
    "name": "sergey/custom-framework",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Core\\": "src/Core/",
            "App\\": "src/App/"
        }
    },
    "authors": [
        {
            "name": "Sergey",
            "email": "siarhei.behiyan@innowise.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "fakerphp/faker": "2.0.x-dev",
        "php": "^8.3",
        "vlucas/phpdotenv": "^5.6@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "2.2.x-dev",
        "friendsofphp/php-cs-fixer": "dev-master"
    },
    "scripts": {
        "cs-fixer": "php-cs-fixer fix --allow-risky=yes",
        "phpstan": "phpstan analyse --memory-limit=-1",
        "fix": [
            "@cs-fixer",
            "@phpstan"
        ]
    }
}